# Copy to .env and fill in. Never commit real values.

DATABASE_URL=postgres://user:password@localhost:5432/wog_db
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
CLIENT_URL=http://localhost:5173
REST_API_URL=http://localhost:5173

JWT_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Crawler (social-track-pipeline). Both sides must use the same secret.
UPSTREAM_URL=http://127.0.0.1:50051
UPSTREAM_SECRET=

# SMTP for the verification and password-reset emails (blank: nothing is sent; verification links are logged, reset links never are)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=WoG

# Paid plans via SePay bank transfer. The first four are required to enable
# billing; without them the server runs and plan purchases answer 503.
# Webhook secret: SePay sends it as "Authorization: Apikey <value>". Use a long random string.
SEPAY_WEBHOOK_API_KEY=
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_HOLDER=
# Optional: SePay API token, enables reconciliation and the "check now" button.
SEPAY_API_TOKEN=
# Optional (defaults shown). The prefix must match SePay's payment-code setting.
SEPAY_PAYMENT_CODE_PREFIX=WOG
ORDER_TTL_MINUTES=30

# Support chat WebSocket: origins allowed to open it besides CLIENT_URL and
# REST_API_URL (comma separated), e.g. your local dev server.
ALLOWED_ORIGINS=

RUST_LOG=info,sqlx::query=info
